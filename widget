    # ======================================================
    # Detect 3D nuclei
    # ======================================================
    def detect_nuclei(self):
        if self.stack is None:
            self.status.setText(
                "Load a Z-stack first."
            )
            return

        self.begin_busy("Detecting 3D nuclei...")

        try:
            self.status.setText(
                "Detecting 3D nuclei..."
            )
            self.set_analysis_progress(
                5,
                "Preparing standardized image..."
            )

            self.set_analysis_progress(
                20,
                "Creating threshold mask..."
            )
            clean, threshold, mode = (
                self.build_mask()
            )

            self.set_analysis_progress(
                65,
                "Labeling connected 3D nuclei..."
            )
            labels = measure.label(
                clean,
                connectivity=CONNECTIVITY
            )

            self.set_analysis_progress(
                85,
                "Updating napari layers..."
            )

            self.labels = labels
            self.analysis_mode_used = mode

            number_of_objects = int(
                labels.max()
            )

            if (
                self.nuclei_layer is None
                or self.nuclei_layer
                not in self.viewer.layers
            ):
                self.nuclei_layer = (
                    self.viewer.add_labels(
                        labels,
                        name="3D nuclei",
                        opacity=0.55,
                    )
                )
            else:
                self.nuclei_layer.data = (
                    labels
                )
                self.nuclei_layer.refresh()

            if self.mask_layer is not None:
                self.mask_layer.visible = False

            self.nucleus_select_box.setMaximum(
                max(1, number_of_objects)
            )
            self.nucleus_select_box.setValue(1)
            self.show_nucleus_numbers()

            min_size = int(
                self.min_size_box.value()
            )

            if mode == "Standardized Auto":
                threshold_line = (
                    f"Auto Otsu threshold: "
                    f"{threshold:.4f}"
                )
            else:
                threshold_line = (
                    f"Manual threshold: "
                    f"{threshold:.4f}"
                )

            self.nuclei_info.setText(
                f"Detected 3D objects: "
                f"{number_of_objects}\n"
                f"Mode: {mode}\n"
                f"{threshold_line}\n"
                f"Minimum size: "
                f"{min_size:,} voxels"
            )

            self.results_df = None
            self.result_text.setPlainText(
                "3D nuclei detected.\n"
                "Press Calculate Volume."
            )

            self.set_analysis_progress(
                100,
                f"3D detection completed: "
                f"{number_of_objects} objects"
            )
            self.status.setText(
                "3D detection completed."
            )

        except Exception as e:
            self.set_analysis_progress(
                0,
                "3D detection failed."
            )
            self.status.setText(
                "3D detection error:\n"
                f"{type(e).__name__}: {e}"
            )
        finally:
            self.end_busy()

    # ======================================================
    # Show nucleus numbers on each Z slice
    # ======================================================
    def show_nucleus_numbers(self):
        if self.labels is None:
            self.status.setText(
                "Run 3D Detection first."
            )
            return

        try:
            points = []
            label_values = []

            max_label = int(self.labels.max())

            # Place one number for each object on every Z slice
            # where that object is present. This makes the CSV label
            # easy to identify while scrolling through Z.
            for label_id in range(1, max_label + 1):
                object_mask = self.labels == label_id
                z_indices = np.where(
                    np.any(object_mask, axis=(1, 2))
                )[0]

                for z in z_indices:
                    yy, xx = np.nonzero(object_mask[z])
                    if yy.size == 0:
                        continue
                    points.append(
                        [
                            float(z),
                            float(np.mean(yy)),
                            float(np.mean(xx)),
                        ]
                    )
                    label_values.append(
                        int(label_id)
                    )

            if self.number_layer is not None and self.number_layer in self.viewer.layers:
                self.viewer.layers.remove(
                    self.number_layer
                )
                self.number_layer = None

            if not points:
                self.status.setText(
                    "No nuclei available for numbering."
                )
                return

            points = np.asarray(points, dtype=float)
            features = {
                "label": np.asarray(label_values, dtype=int)
            }
            text = {
                "string": "{label}",
                "size": 14,
                "color": "yellow",
            }

            self.number_layer = self.viewer.add_points(
                points,
                features=features,
                text=text,
                size=2,
                name="Nucleus numbers (CSV label)",
                opacity=1.0,
            )

            self.status.setText(
                "Nucleus numbers displayed. "
                "They match the CSV label column."
            )

        except Exception as e:
            self.status.setText(
                "Number display error:\n"
                f"{type(e).__name__}: {e}"
            )

    # ======================================================
    # Show selected nucleus in physically scaled 3D
    # ======================================================
    def show_selected_nucleus_3d(self):
        if self.labels is None:
            self.status.setText(
                "Run 3D Detection first."
            )
            return

        try:
            label_id = int(
                self.nucleus_select_box.value()
            )

            selected = (
                self.labels == label_id
            ).astype(np.uint8)

            if not np.any(selected):
                self.status.setText(
                    f"Nucleus {label_id} was not found."
                )
                return

            if (
                self.selected_nucleus_layer is not None
                and self.selected_nucleus_layer in self.viewer.layers
            ):
                self.viewer.layers.remove(
                    self.selected_nucleus_layer
                )

            z_um = float(self.z_box.value())
            xy_um = float(self.xy_box.value())
            scale = (z_um, xy_um, xy_um)

            # Apply the same physical scale to all aligned 3D layers.
            for layer in [
                self.image_layer,
                self.mask_layer,
                self.nuclei_layer,
                self.number_layer,
            ]:
                if layer is not None and layer in self.viewer.layers:
                    layer.scale = scale

            self.selected_nucleus_layer = self.viewer.add_labels(
                selected,
                name=f"Selected nucleus {label_id} - 3D",
                opacity=0.75,
                scale=scale,
            )

            if self.nuclei_layer is not None:
                self.nuclei_layer.visible = False
            if self.mask_layer is not None:
                self.mask_layer.visible = False
            if self.number_layer is not None:
                self.number_layer.visible = False

            self.viewer.dims.ndisplay = 3

            self.status.setText(
                f"Showing nucleus {label_id} in 3D. "
                f"Scale: XY={xy_um:.6f} µm, Z={z_um:.6f} µm."
            )

        except Exception as e:
            self.status.setText(
                "3D display error:\n"
                f"{type(e).__name__}: {e}"
            )

