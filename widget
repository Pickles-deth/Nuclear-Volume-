# ============================================================
PROTOCOL_NAME = "Standardized Auto Nuclear Volume"
PROTOCOL_VERSION = "1.0"

# These values are intentionally fixed for fair comparison.
NORM_LOW_PERCENTILE = 1.0
NORM_HIGH_PERCENTILE = 99.8
GAUSSIAN_SIGMA = 1.0
CLOSING_RADIUS = 1
CONNECTIVITY = 1


def natural_key(text):
    return [
        int(c) if c.isdigit() else c.lower()
        for c in re.split(r"(\d+)", text)
    ]


