        self.load_progress_label.setText(
            str(message)
        )
        QApplication.processEvents()

    def set_analysis_progress(self, value, message):
        self.analysis_progress.setValue(
            int(max(0, min(100, value)))
        )
        self.analysis_progress_label.setText(
            str(message)
