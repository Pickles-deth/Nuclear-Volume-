    # ======================================================
    # Calculate volume
    # ======================================================
    def calculate_volume(self):
        if self.labels is None:
            self.status.setText(
                "Run 3D Detection first."
            )
            return

        self.begin_busy("Calculating volume...")

        try:
            self.set_analysis_progress(
                10,
                "Reading voxel calibration..."
            )

            xy_um = float(
                self.xy_box.value()
            )

            z_um = float(
                self.z_box.value()
            )

            voxel_volume = (
                xy_um
                * xy_um
                * z_um
            )

            self.set_analysis_progress(
                35,
                "Measuring 3D objects..."
            )

            props = measure.regionprops_table(
                self.labels,
                properties=(
                    "label",
                    "area",
                    "bbox",
                )
            )

            df = pd.DataFrame(
                props
            )

            if len(df) == 0:
                self.status.setText(
                    "No 3D objects were found."
                )
                self.result_text.setPlainText(
                    "No volume results."
                )
                return

            # In a 3D label image, area = voxel count.
            df = df.rename(
                columns={
                    "area": "voxels"
                }
            )

            df["voxels"] = (
                df["voxels"].astype(
                    np.int64
                )
            )

            df["volume_um3"] = (
                df["voxels"]
                * voxel_volume
            )

            df["z_start_index"] = (
                df["bbox-0"].astype(int)
            )

            df["z_end_index"] = (
                df["bbox-3"].astype(int)
                - 1
            )

            df["z_slices"] = (
                df["bbox-3"]
                - df["bbox-0"]
            ).astype(int)

            bbox_columns = [
                column
                for column in df.columns
                if column.startswith(
                    "bbox-"
                )
            ]

            df = df.drop(
                columns=bbox_columns
            )

            mode = (
                self.analysis_mode_used
                if self.analysis_mode_used
                is not None
                else (
                    "Standardized Auto"
                    if self.is_auto_mode()
                    else
                    "Advanced Manual Threshold"
                )
            )

            if mode == "Standardized Auto":
                threshold_norm = float(
                    self.auto_threshold_norm
                )
            else:
                threshold_norm = (
                    self.threshold_slider.value()
                    / 1000.0
                )

            threshold_raw_equiv = float(
                self.norm_low_value
                + threshold_norm
                * (
                    self.norm_high_value
                    - self.norm_low_value
                )
            )

            # ==================================================
            # Record the full analysis conditions in every row.
            # This allows later verification that the same
            # protocol was used for all samples.
            # ==================================================
            df["analysis_mode"] = mode
            df["manual_adjustment"] = (
                "No"
                if mode == "Standardized Auto"
                else "Yes"
            )
            df["protocol_name"] = (
                PROTOCOL_NAME
            )
            df["protocol_version"] = (
                PROTOCOL_VERSION
            )
            df["normalization_low_percentile"] = (
                NORM_LOW_PERCENTILE
            )
            df["normalization_high_percentile"] = (
                NORM_HIGH_PERCENTILE
            )
            df["normalization_low_raw"] = (
                self.norm_low_value
            )
            df["normalization_high_raw"] = (
                self.norm_high_value
            )
            df["background_estimate_raw"] = (
                self.background_value
            )
            df["threshold_method"] = (
                "Otsu"
                if mode == "Standardized Auto"
                else "Manual"
            )
            df["threshold_normalized"] = (
                threshold_norm
            )
            df["threshold_raw_equivalent"] = (
                threshold_raw_equiv
            )
            df["gaussian_sigma"] = (
                GAUSSIAN_SIGMA
            )
            df["minimum_object_size_voxels"] = (
                int(
                    self.min_size_box.value()
                )
            )
            df["closing_radius_voxels"] = (
                CLOSING_RADIUS
            )
            df["connectivity"] = (
                CONNECTIVITY
            )
            df["xy_pixel_size_um"] = (
                xy_um
            )
            df["z_spacing_um"] = (
                z_um
            )
            df["voxel_volume_um3"] = (
                voxel_volume
            )

            preferred_columns = [
                "label",
                "voxels",
                "volume_um3",
                "z_start_index",
                "z_end_index",
                "z_slices",
                "analysis_mode",
                "manual_adjustment",
                "protocol_name",
                "protocol_version",
                "threshold_method",
                "threshold_normalized",
                "threshold_raw_equivalent",
                "normalization_low_percentile",
                "normalization_high_percentile",
                "normalization_low_raw",
                "normalization_high_raw",
                "background_estimate_raw",
                "gaussian_sigma",
                "minimum_object_size_voxels",
                "closing_radius_voxels",
                "connectivity",
                "xy_pixel_size_um",
                "z_spacing_um",
                "voxel_volume_um3",
            ]

            df = df[
                preferred_columns
            ]

            df = df.sort_values(
                "label"
            ).reset_index(
                drop=True
            )

            self.results_df = df

            # ==================================================
            # Show compact results immediately in the napari UI
            # ==================================================
            mean_volume = float(df["volume_um3"].mean())
            median_volume = float(df["volume_um3"].median())
            self.result_summary.setText(
                f"Calculated nuclei: {len(df)} | "
                f"Mean volume: {mean_volume:.3f} µm³ | "
                f"Median: {median_volume:.3f} µm³"
            )

            self.result_table.setRowCount(len(df))
            table_columns = [
                "label",
                "volume_um3",
                "voxels",
                "z_start_index",
                "z_end_index",
                "z_slices",
            ]

            for table_row, (_, row) in enumerate(df.iterrows()):
                values = [
                    str(int(row["label"])),
                    f'{float(row["volume_um3"]):.3f}',
                    f'{int(row["voxels"]):,}',
                    str(int(row["z_start_index"])),
                    str(int(row["z_end_index"])),
                    str(int(row["z_slices"])),
                ]
                for table_col, value in enumerate(values):
                    item = QTableWidgetItem(value)
                    self.result_table.setItem(
                        table_row, table_col, item
                    )

            self.result_table.resizeColumnsToContents()

            # ==================================================
            # Show results
            # ==================================================
            lines = []

            lines.append(
                f"Protocol: "
                f"{PROTOCOL_NAME} "
                f"v{PROTOCOL_VERSION}"
            )
            lines.append(
                f"Mode: {mode}"
            )
            lines.append(
                f"Threshold method: "
                f"{'Otsu' if mode == 'Standardized Auto' else 'Manual'}"
            )
            lines.append(
                f"Normalized threshold: "
                f"{threshold_norm:.4f}"
            )
            lines.append(
                f"Raw-equivalent threshold: "
                f"{threshold_raw_equiv:.3f}"
            )
            lines.append(
                ""
            )

            lines.append(
                "Voxel size:"
            )
            lines.append(
                f"XY = {xy_um:.6f} µm"
            )
            lines.append(
                f"Z  = {z_um:.6f} µm"
            )
            lines.append(
                f"Voxel volume = "
                f"{voxel_volume:.9f} µm³"
            )
            lines.append(
                ""
            )
            lines.append(
                f"Detected nuclei: "
                f"{len(df)}"
            )
            lines.append(
                ""
            )

            max_preview = 100

            for _, row in df.head(
                max_preview
            ).iterrows():
                lines.append(
                    f"Nucleus "
                    f"{int(row['label'])}: "
                    f"{row['volume_um3']:.3f} µm³ "
                    f"({int(row['voxels']):,} voxels, "
                    f"Z {int(row['z_start_index'])}"
                    f"-{int(row['z_end_index'])})"
                )

            if len(df) > max_preview:
                lines.append("")
                lines.append(
                    f"... and "
                    f"{len(df) - max_preview} "
                    f"more objects."
                )

            self.result_text.setPlainText(
                "\n".join(lines)
            )

            self.set_analysis_progress(
                100,
                f"Volume calculation completed: "
                f"{len(df)} nuclei"
            )
            self.status.setText(
                "Volume calculation completed."
            )

        except Exception as e:
            self.set_analysis_progress(
                0,
                "Volume calculation failed."
            )
            self.status.setText(
                "Volume calculation error:\n"
                f"{type(e).__name__}: {e}"
            )
        finally:
            self.end_busy()

    # ======================================================
    # Export CSV
    # ======================================================
    def export_csv(self):
        if (
            self.results_df is None
            or len(self.results_df) == 0
        ):
            self.status.setText(
                "Calculate Volume first."
            )
            return

        try:
            path, _ = QFileDialog.getSaveFileName(
                self,
                "Save volume results",
                "nuclear_volume_results.csv",
                "CSV Files (*.csv)"
            )

            if not path:
                return

            if not path.lower().endswith(
                ".csv"
            ):
                path += ".csv"

            self.results_df.to_csv(
                path,
                index=False,
                encoding="utf-8-sig"
            )

            self.status.setText(
                f"CSV saved:\n{path}"
            )

        except Exception as e:
            self.status.setText(
                "CSV export error:\n"
                f"{type(e).__name__}: {e}"
            )
