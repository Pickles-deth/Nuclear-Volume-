    # ======================================================
    # UI stability helpers
    # ======================================================
    def begin_busy(self, message=None):
        """Lock analysis controls during a long operation.

        This is intentionally UI-only: it does not change the image,
        segmentation parameters, thresholding, labeling, or volume math.
        """
        if self._busy:
            return False

        self._busy = True
        self._busy_mode_index = int(self.mode_box.currentIndex())

        widgets = [
            self.mode_box,
            self.open_button,
            self.detect_button,
            self.volume_button,
            self.csv_button,
            self.min_size_box,
            self.xy_box,
            self.z_box,
            self.threshold_slider,
            self.threshold_box,
            self.nucleus_select_box,
            self.show_numbers_button,
            self.show_selected_3d_button,
            self.back_2d_button,
        ]

        for widget in widgets:
            widget.setEnabled(False)

        if message:
            self.status.setText(str(message))

        # Apply the disabled state before the heavy work starts so that
        # accidental clicks are not queued while Windows is busy.
        QApplication.processEvents()
        return True

    def end_busy(self):
        """Restore the UI and the mode that was active at start."""
        saved_index = self._busy_mode_index

        if saved_index is not None:
            blocker = QSignalBlocker(self.mode_box)
            self.mode_box.setCurrentIndex(int(saved_index))
            del blocker

        widgets = [
            self.mode_box,
            self.open_button,
            self.detect_button,
            self.volume_button,
            self.csv_button,
            self.min_size_box,
            self.xy_box,
            self.z_box,
            self.nucleus_select_box,
            self.show_numbers_button,
            self.show_selected_3d_button,
            self.back_2d_button,
        ]

        for widget in widgets:
            widget.setEnabled(True)

        auto = self.is_auto_mode()
        self.manual_group.setVisible(not auto)
        self.threshold_slider.setEnabled(not auto)
        self.threshold_box.setEnabled(not auto)

        if auto:
            self.detect_button.setText(
                "Run Standardized 3D Detection"
            )
        else:
            self.detect_button.setText(
                "Run Manual 3D Detection"
            )

        self._busy = False
        self._busy_mode_index = None
        QApplication.processEvents()

    # ======================================================
    # Progress helpers
