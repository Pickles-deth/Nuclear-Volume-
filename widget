    def is_auto_mode(self):
        return self.mode_box.currentIndex() == 0

    def update_mode_ui(self):
        auto = self.is_auto_mode()
        self.manual_group.setVisible(not auto)

        if auto:
            self.detect_button.setText(
                "Run Standardized 3D Detection"
            )
        else:
            self.detect_button.setText(
                "Run Manual 3D Detection"
            )

        if self.stack is not None:
            if auto:
                self.update_auto_preview()
            else:
                self.update_threshold_preview(
                    self.threshold_slider.value()
                )

    # ======================================================
    # Open folder
    # ======================================================
    def open_folder(self):
        folder = QFileDialog.getExistingDirectory(
            self,
            "Select Z-stack folder"
        )

        if not folder:
            return

        self.begin_busy("Loading Z-stack...")

        self.folder_label.setText(folder)
        self.status.setText(
            "Searching TIFF files..."
        )
        self.set_load_progress(
            0,
            "Searching TIFF files..."
        )

        try:
            all_tiff_files = []

            for filename in os.listdir(folder):
                lower = filename.lower()

                if (
                    lower.endswith(".tif")
                    or lower.endswith(".tiff")
                ):
                    all_tiff_files.append(
                        os.path.join(
                            folder,
                            filename
                        )
                    )

            if len(all_tiff_files) == 0:
                self.status.setText(
                    "No .tif or .tiff files were found."
                )
                return

            z_files = []

            for path in all_tiff_files:
                filename = os.path.basename(path)

                match = re.search(
                    r"z(\d+)",
                    filename,
                    re.IGNORECASE
                )

                if match:
                    z_number = int(
                        match.group(1)
                    )

                    z_files.append(
                        (
                            z_number,
                            path
                        )
                    )

            # Fallback: natural filename order if z### is absent.
            if len(z_files) == 0:
                sorted_paths = sorted(
                    all_tiff_files,
                    key=lambda p: natural_key(
                        os.path.basename(p)
                    )
                )
                z_files = [
                    (i + 1, p)
                    for i, p in enumerate(
                        sorted_paths
                    )
                ]

            z_files.sort(
                key=lambda x: x[0]
            )

            z_numbers = [
                z for z, path in z_files
            ]

            duplicates = sorted(
                {
                    z
                    for z in z_numbers
                    if z_numbers.count(z) > 1
                }
            )

            if duplicates:
                self.status.setText(
                    "Duplicate Z numbers found:\n"
                    f"{duplicates[:20]}"
                )
                return

            images = []
            target_shape = None
            total = len(z_files)

            for i, (z_number, path) in enumerate(
                z_files
            ):
                img = tifffile.imread(path)

                # RGB/RGBA -> brightest RGB value.
                # If your acquisition is genuinely multichannel,
                # use a single nuclear channel before analysis.
                if (
                    img.ndim == 3
                    and img.shape[-1] in (3, 4)
                ):
                    img = np.max(
                        img[..., :3],
                        axis=-1
                    )

                if img.ndim != 2:
                    raise ValueError(
                        f"Unsupported image shape: "
                        f"{img.shape}\n"
                        f"{os.path.basename(path)}"
                    )

                if target_shape is None:
                    target_shape = img.shape

                if img.shape != target_shape:
                    raise ValueError(
                        "Image sizes are not identical.\n"
                        f"Expected: {target_shape}\n"
                        f"Found: {img.shape}\n"
                        f"File: {os.path.basename(path)}"
                    )

                images.append(img)

                progress_value = int(
                    round(
                        (i + 1)
                        / max(total, 1)
                        * 80
                    )
                )

                self.status.setText(
                    f"Loading {i + 1}/{total}"
                )
                self.set_load_progress(
                    progress_value,
                    f"Loading Z-stack: "
                    f"{i + 1}/{total} slices"
                )

            self.stack = np.stack(
                images,
                axis=0
            )

            self.set_load_progress(
                85,
                "Combining slices into 3D stack..."
            )

            self.set_load_progress(
                90,
                "Standardizing fluorescence intensity..."
            )
            self.prepare_standardized_stack()

            self.set_load_progress(
                96,
                "Preparing napari display..."
            )

            # Reset old analysis
            self.labels = None
            self.results_df = None

            self.result_text.setPlainText(
                "Detailed analysis information will appear here."
            )
            self.result_summary.setText(
                "No volume results."
            )
            self.result_table.setRowCount(0)

            # Remove old layers
            for layer in [
                self.selected_nucleus_layer,
                self.number_layer,
                self.nuclei_layer,
                self.mask_layer,
                self.image_layer,
            ]:
                if (
                    layer is not None
                    and layer in self.viewer.layers
                ):
                    self.viewer.layers.remove(
                        layer
                    )

            self.selected_nucleus_layer = None
            self.number_layer = None
            self.nuclei_layer = None
            self.mask_layer = None
            self.image_layer = None

            stack_min = float(
                np.min(self.stack)
            )
            stack_max = float(
                np.max(self.stack)
            )

            p_low = self.norm_low_value
            p_high = self.norm_high_value

            if p_high <= p_low:
                p_low = stack_min
                p_high = stack_max

            if p_high <= p_low:
                p_low = 0.0
                p_high = 1.0

            self.image_layer = (
                self.viewer.add_image(
                    self.stack,
                    name="Original Z-stack",
                    colormap="gray",
                    contrast_limits=(
                        p_low,
                        p_high
                    ),
                )
            )

            first_z = z_files[0][0]
            last_z = z_files[-1][0]

            self.stack_info.setText(
                f"Z slices: {self.stack.shape[0]}\n"
                f"Z range: {first_z} - {last_z}\n"
                f"Stack shape: {self.stack.shape}\n"
                f"Raw intensity: "
                f"{stack_min:.0f} - {stack_max:.0f}\n"
                f"P{NORM_LOW_PERCENTILE:g}: "
                f"{self.norm_low_value:.3f}\n"
                f"P{NORM_HIGH_PERCENTILE:g}: "
                f"{self.norm_high_value:.3f}"
            )

            self.update_mode_ui()

            self.set_load_progress(
                100,
                f"Loaded successfully: "
                f"{self.stack.shape[0]} slices"
            )
            self.status.setText(
                "Z-stack loaded successfully."
            )

        except Exception as e:
            self.set_load_progress(
                0,
                "Load failed."
            )
            self.status.setText(
                "ERROR:\n"
                f"{type(e).__name__}: {e}"
            )
        finally:
            self.end_busy()

    # ======================================================
    # Standardized preprocessing
    # ======================================================
    def prepare_standardized_stack(self):
        if self.stack is None:
            return

        x = np.asarray(
            self.stack,
            dtype=np.float32
        )

        self.norm_low_value = float(
            np.percentile(
                x,
                NORM_LOW_PERCENTILE
            )
        )

        self.norm_high_value = float(
            np.percentile(
                x,
                NORM_HIGH_PERCENTILE
            )
        )

        if (
            not np.isfinite(self.norm_low_value)
            or not np.isfinite(self.norm_high_value)
            or self.norm_high_value
            <= self.norm_low_value
        ):
            self.norm_low_value = float(
                np.min(x)
            )
            self.norm_high_value = float(
                np.max(x)
            )

        if (
            self.norm_high_value
            <= self.norm_low_value
        ):
            self.norm_high_value = (
                self.norm_low_value + 1.0
            )

        # Robust 0-1 normalization.
        normalized = (
            x - self.norm_low_value
        ) / (
            self.norm_high_value
            - self.norm_low_value
        )

        normalized = np.clip(
            normalized,
            0.0,
            1.0
        ).astype(
            np.float32,
            copy=False
        )

        self.normalized_stack = normalized

        # Fixed 3D Gaussian smoothing.
        self.smoothed_stack = filters.gaussian(
            normalized,
            sigma=GAUSSIAN_SIGMA,
            preserve_range=True
        ).astype(
            np.float32,
            copy=False
        )

        # Otsu threshold is calculated after exactly
        # the same normalization and smoothing rule.
        finite_values = self.smoothed_stack[
            np.isfinite(self.smoothed_stack)
        ]

        if finite_values.size == 0:
            raise ValueError(
                "No finite intensity values."
            )

        self.auto_threshold_norm = float(
            filters.threshold_otsu(
                finite_values
            )
        )

        self.auto_threshold_raw_equiv = float(
            self.norm_low_value
            + self.auto_threshold_norm
            * (
                self.norm_high_value
                - self.norm_low_value
            )
        )

        # The lower percentile is a robust estimate
        # of the dark/background intensity level.
        self.background_value = float(
            self.norm_low_value
        )

    # ======================================================
    # Mask creation
    # ======================================================
    def build_mask(self):
        if self.stack is None:
            raise ValueError(
                "Load a Z-stack first."
            )

        if self.smoothed_stack is None:
            self.prepare_standardized_stack()

        if self.is_auto_mode():
            threshold = float(
                self.auto_threshold_norm
            )
            mode = (
                "Standardized Auto"
            )
        else:
            threshold = (
                self.threshold_slider.value()
                / 1000.0
            )
            mode = (
                "Advanced Manual Threshold"
            )

        mask = (
            self.smoothed_stack
            > threshold
        )

        min_size = int(
            self.min_size_box.value()
        )

        # Remove small components.
        clean = morphology.remove_small_objects(
            mask,
            min_size=min_size
        )

        # Mild fixed 3D closing.
        clean = morphology.binary_closing(
            clean,
            morphology.ball(
                CLOSING_RADIUS
            )
        )

        # Fill internal holes in 3D.
        clean = ndi.binary_fill_holes(
            clean
        )

        # Closing/filling can leave tiny islands;
        # enforce the same minimum size again.
        clean = morphology.remove_small_objects(
            clean,
            min_size=min_size
        )

        return (
            clean.astype(bool),
            threshold,
            mode
        )

    # ======================================================
    # Preview helpers
    # ======================================================
    def show_mask_preview(
        self,
        mask,
        threshold,
        mode
    ):
        positive_voxels = int(
            np.count_nonzero(mask)
        )

        percentage = (
            positive_voxels
            / mask.size
            * 100.0
        )

        mask_uint8 = mask.astype(
            np.uint8
        )

        if (
            self.mask_layer is None
            or self.mask_layer
            not in self.viewer.layers
        ):
            self.mask_layer = (
                self.viewer.add_labels(
                    mask_uint8,
                    name="Segmentation preview",
                    opacity=0.35,
                )
            )
        else:
            self.mask_layer.data = (
                mask_uint8
            )
            self.mask_layer.refresh()

        if mode == "Standardized Auto":
            raw_equiv = (
                self.auto_threshold_raw_equiv
            )
            threshold_text = (
                f"Auto threshold "
                f"(normalized): "
                f"{threshold:.4f}\n"
                f"Approx. raw-equivalent: "
                f"{raw_equiv:.3f}"
            )
        else:
            raw_equiv = (
                self.norm_low_value
                + threshold
                * (
                    self.norm_high_value
                    - self.norm_low_value
                )
            )
            threshold_text = (
                f"Manual threshold "
                f"(normalized): "
                f"{threshold:.4f}\n"
                f"Approx. raw-equivalent: "
                f"{raw_equiv:.3f}"
            )

        self.mask_info.setText(
            f"Mode: {mode}\n"
            f"{threshold_text}\n"
            f"Positive voxels: "
            f"{positive_voxels:,}\n"
            f"Fraction: "
            f"{percentage:.3f}%"
        )

    def update_auto_preview(self):
        if self.stack is None:
